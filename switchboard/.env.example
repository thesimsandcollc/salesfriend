# Which CarrierProvider backs this instance. "mock" (default) needs no
# credentials at all -- start here. "telnyx" is the real carrier integration.
SWITCHBOARD_CARRIER=mock

# --- Telnyx (only needed if SWITCHBOARD_CARRIER=telnyx) ---------------------
# https://portal.telnyx.com -> API Keys
TELNYX_API_KEY=
# Portal -> Account Settings -> Public Key, used to verify inbound webhooks
TELNYX_PUBLIC_KEY=
# Portal -> Messaging -> Messaging Profiles (needed to send SMS)
TELNYX_MESSAGING_PROFILE_ID=
# Portal -> Voice -> Programmable Voice -> Connections (needed to make calls)
TELNYX_CONNECTION_ID=

# --- General -----------------------------------------------------------------
SWITCHBOARD_DATABASE_PATH=./switchboard.db
# Public https URL this server is reachable at -- required for Telnyx to
# reach /carrier/telnyx/* and for outbound calls. Not needed for mock.
SWITCHBOARD_PUBLIC_BASE_URL=

SWITCHBOARD_WEBHOOK_MAX_ATTEMPTS=6
SWITCHBOARD_WEBHOOK_RETRY_INTERVAL_SECONDS=60

# Dashboard login (HTTP Basic). Leave blank for open access on localhost --
# always set this before deploying anywhere reachable from the internet.
SWITCHBOARD_DASHBOARD_USERNAME=admin
SWITCHBOARD_DASHBOARD_PASSWORD=

SWITCHBOARD_BOOTSTRAP_KEY_LABEL=bootstrap
